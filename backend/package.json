{
  "name": "todo-list-tdd",
  "version": "1.0.0",
  "description": "Todo List API avec Node.js, Jest et TDD",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=todo.e2e.test.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "keywords": [
    "nodejs",
    "jest",
    "tdd",
    "todo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "nodemailer": "^10.0.10"
  }
}
